{
  "rewrites": [
    { "source": "/booking/thank-you", "destination": "/booking/thank-you/index.html" },
    { "source": "/booking", "destination": "/booking/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" }
  ],
  "crons": [
    { "path": "/api/email-worker", "schedule": "0 9 * * *" },
    { "path": "/api/sheets-worker", "schedule": "0 10 * * *" }
  ],
  "functions": {
    "api/email-worker.ts": { "maxDuration": 60 },
    "api/sheets-worker.ts": { "maxDuration": 60 },
    "api/waitlist.ts": { "maxDuration": 60 },
    "api/applicants.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
