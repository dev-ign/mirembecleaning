{
  "name": "mirembe-cleaning-waitlist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run seo:generate -- --mode development && vite",
    "build": "npm run seo:generate -- --mode production && tsc -b && tsc -p tsconfig.api.json && vite build",
    "seo:generate": "node --import tsx scripts/generate-seo.ts",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "sheets:admin": "tsx scripts/sheets-admin.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:seo": "node --import tsx scripts/verify-seo-build.ts",
    "test:http": "node --import tsx scripts/verify-site-http.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@react-email/render": "2.1.0",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/functions": "3.9.11",
    "google-auth-library": "^10.5.0",
    "i18next": "^26.5.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.9",
    "resend": "6.12.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
