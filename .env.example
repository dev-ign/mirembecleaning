# Server only. Never prefix these with VITE_ or expose the secret in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
TURNSTILE_SECRET_KEY=your-server-only-turnstile-secret
RESEND_API_KEY=your-server-only-resend-key
RESEND_FROM_EMAIL="Mirembe Cleaning <no-reply@mirembecleaning.com>"
RESEND_CAREERS_EMAIL="Mirembe Cleaning Careers <no-reply@mirembecleaning.com>"
MIREMBE_NOTIFICATION_EMAIL=mirembecleaning@gmail.com
CRON_SECRET=your-random-server-only-cron-secret-at-least-16-characters
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Public Cloudflare Turnstile site key, safe to embed in the browser.
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key

# Public client configuration. Set to a published policy URL before launch.
VITE_PRIVACY_POLICY_URL=https://example.com/privacy

# Optional marketing providers. No tags load until a visitor allows tracking.
VITE_GA4_MEASUREMENT_ID=your-GA4-measurement-id
VITE_META_PIXEL_ID=your-Meta-pixel-id
